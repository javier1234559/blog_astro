---
import PageMeta from "../components/PageMeta.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Intro from "../components/Intro.astro";
import siteMetadata from "@/content/sideMetaData";
import ImageStack from "@/components/feature/ImageStack";

const metaData = {
  title: "Nhat's Blog — Fullstack Developer Notes & Thoughts",
  description: siteMetadata.description,
  pagePath: "/",
};
---

<PageLayout>
  <PageMeta slot="meta" {...metaData} />
  <section
    slot="main"
    class="px-6 py-12 max-w-7xl mx-auto min-h-[80vh] flex items-center"
  >
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <Intro />
      <ImageStack client:only="react" />
    </div>
  </section>
</PageLayout>
