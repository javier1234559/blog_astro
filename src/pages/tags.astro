---
import siteMetadata from "@/content/sideMetaData";
import PageLayout from "@/layouts/PageLayout.astro";
import PageMeta from "@/components/PageMeta.astro";
import Hashtags from "@/components/Tags.astro";
import { TextRevealTW } from "@/components/feature/TextRevealTW";

const metaData = {
  title: "Tags",
  description:
    "Browse all topics and hashtags on Nhat's Blog — web development, software engineering, and personal notes.",
  pagePath: "/tags",
};
---

<PageLayout>
  <PageMeta slot="meta" {...metaData} />
  <section slot="main" class="px-6 py-12 max-w-7xl mx-auto min-h-[80vh] ">
    <TextRevealTW client:load as="h1" className='text-3xl font-bold uppercase md:text-5xl' content="Tags" />
    <Hashtags />
  </section>
</PageLayout>
